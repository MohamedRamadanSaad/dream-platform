{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  # API — the real backend. Until it exists, the frontend runs with mocks and never calls /api.
  handle /api/* {
    reverse_proxy backend:8080 {
      header_up X-Request-Id {http.request.uuid}
      # Cloudflare is not in front of the site, so these can only come from the visitor: drop them. The server decides
      # the country (GeoIP on the real client address) and rate limits use the address Caddy saw. If the site moves
      # behind Cloudflare, trust CF-IPCountry / CF-Connecting-IP only from Cloudflare's address ranges instead.
      header_up -CF-IPCountry
      header_up -CF-Connecting-IP
      header_up -X-Real-IP
      header_up -Forwarded
      header_up -X-Country
    }
  }

  handle {
    reverse_proxy frontend:80
  }
}

# Redirect www -> apex (only matters if DOMAIN is the apex)
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}
