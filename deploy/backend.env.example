# =============================================================================
# Backend environment variables (Spring Boot). Copy to .env / deploy/backend.env.
# Local development needs none of these (application-local.yml has defaults).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# Spring profile: local | dev | prod
SPRING_PROFILES_ACTIVE=prod
# HTTP port inside the container (API served under /api)
PORT=8080
# JVM flags (the image default already sets MaxRAMPercentage=75)
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# Log level of com.saadat.* (INFO in prod, DEBUG locally)
LOG_LEVEL_APP=INFO

# ---- Database (PostgreSQL 16) -----------------------------------------------
# JDBC URL; inside docker compose the host is the "postgres" service
DB_URL=jdbc:postgresql://postgres:5432/dreams
DB_USERNAME=dreams
DB_PASSWORD=change-me
# Hikari max pool size
DB_POOL_SIZE=10

# ---- Public URLs / CORS -----------------------------------------------------
# SPA origin, used for CORS, magic-link and checkout return URLs (no trailing slash)
FRONTEND_URL=https://saadatu-aldarein.com
# Public API base including /api (OpenAPI server URL, links in e-mails)
API_URL=https://saadatu-aldarein.com/api
# Extra CORS origins, comma-separated (FRONTEND_URL is always allowed)
CORS_ALLOWED_ORIGINS=

# ---- Auth -------------------------------------------------------------------
# HS256 secret for access tokens, >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
# JWT "iss" claim
JWT_ISSUER=saadat-api
# Google OAuth web client id (audience of Google ID tokens); empty disables Google login
GOOGLE_CLIENT_ID=
# Local profile only: e-mail that idToken "mock" logs in as
AUTH_MOCK_EMAIL=
# Comma-separated e-mails granted INTERPRETER on first login (merged with setting interpreter.emails)
INTERPRETER_EMAILS=

# ---- Payments ---------------------------------------------------------------
# true = MockPaymentProvider + POST /webhooks/mock/{orderId}. Ignored (forced false) in prod.
# On the VPS, deploy-vps.yml writes PAYMENTS_MOCK=false only when the 3 KASHIER_* GitHub secrets exist AND the
# repository variable PAYMENTS_LIVE is "true" (never writes true back).
PAYMENTS_MOCK=false
# Kashier (EGP). Dashboard → Integration: Payment API Key, Secret Key; MID under the account name.
# Test and live keys differ; KASHIER_MODE must match them (test | live). On the VPS they come from GitHub secrets of
# the same names (deploy-vps.yml, step "kashier settings"). The webhook URL is sent with every payment session:
# https://saadatu-aldarein.com/api/webhooks/kashier
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MODE=test
# Optional API host override (default https://test-api.kashier.io or https://api.kashier.io by mode)
KASHIER_BASE_URL=
# Merchant-of-record provider (SAR/USD) — not configured yet → 503 NOT_CONFIGURED
MOR_API_KEY=
MOR_STORE_ID=
MOR_WEBHOOK_SECRET=
MOR_BASE_URL=

# ---- E-mail (SMTP) ----------------------------------------------------------
# Empty SMTP_HOST → e-mails are rendered and logged (status LOGGED), not sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# From address and display name
MAIL_FROM=no-reply@saadatu-aldarein.com
MAIL_FROM_NAME=إلى سعادة الدارين
# Support mailbox webhook (POST /api/webhooks/mail/inbound, Hostinger event message.received): the secret
# Hostinger shows once when the webhook is created; it arrives as "Authorization: Bearer <secret>".
# Empty = the endpoint answers 503 and no auto-reply is sent.
MAIL_WEBHOOK_SECRET=

# ---- Web push (VAPID) -------------------------------------------------------
# On the VPS the pair is generated on the server by deploy-vps.yml (deploy/ops/vapid-keys.sh) when
# VAPID_PRIVATE_KEY is empty, and never replaced. Elsewhere: npx web-push generate-vapid-keys
# (public = 65-byte uncompressed P-256 point, private = 32-byte scalar, both base64url without padding).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:support@saadatu-aldarein.com
VAPID_SUBJECT=

# ---- YouTube ----------------------------------------------------------------
# RSS feed template; {channelId} comes from setting brand.youtube_channel_id (filled automatically from the
# channel page in setting brand.youtube_url while it is empty)
YOUTUBE_FEED_URL=https://www.youtube.com/feeds/videos.xml?channel_id={channelId}

# ---- Visitor country (GeoIP) ------------------------------------------------
# MMDB file used when the CF-IPCountry header is absent; empty or missing file = no lookup (default country).
# On the VPS docker-compose.yml sets it to /geoip/dbip-country-lite.mmdb (DB-IP "IP to Country Lite", CC BY 4.0,
# downloaded monthly by deploy-vps.yml into /opt/saadat/geoip), which overrides this file.
# GEOIP_DB_PATH=

# ---- Observability / docs ---------------------------------------------------
# Sentry DSN (empty disables Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
# Expose /api/v3/api-docs and /api/swagger-ui.html (default: true, false in prod)
SWAGGER_ENABLED=false

# ---- Rate limiting ----------------------------------------------------------
# Master switch for the in-memory Bucket4j limits (auth 10/min/IP, POST /dreams 30/min/user, checkout 5/min/IP)
RATE_LIMIT_ENABLED=true
